MYSQL_PROFILE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=aviation_dw
MYSQL_USER=replace_with_read_only_user
MYSQL_PASSWORD=replace_with_read_only_password

# Optional local Aiven profile for testing. Do not copy passwords or certificates here.
# For Streamlit Cloud, configure [database] and [mysql.aiven] in app secrets instead.
# MYSQL_PROFILE=aiven
# MYSQL_AIVEN_HOST=mysql-nanh-flight.e.aivencloud.com
# MYSQL_AIVEN_PORT=26015
# MYSQL_AIVEN_DATABASE=defaultdb
# MYSQL_AIVEN_USER=avnadmin
# MYSQL_AIVEN_PASSWORD=replace_with_aiven_password
# MYSQL_AIVEN_SSL_CA=C:\path\to\ca.pem
# Or set MYSQL_AIVEN_SSL_CA_PEM to the full PEM contents in a protected environment variable.